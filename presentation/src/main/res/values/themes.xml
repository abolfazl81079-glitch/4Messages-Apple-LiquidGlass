<?xml version="1.0" encoding="utf-8"?>
<resources>

    <attr name="bubbleColor" format="reference" />
    <attr name="switchThumbEnabled" format="color" />
    <attr name="switchThumbDisabled" format="color" />
    <attr name="switchTrackEnabled" format="color" />
    <attr name="switchTrackDisabled" format="color" />

    <style name="AppLaunchTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:navigationBarColor">#10141C</item>
        <item name="android:statusBarColor">#2B3444</item>
        <item name="android:windowBackground">@drawable/bg_glass_dark</item>
    </style>

    <style name="AppTheme" parent="AppBaseTheme" />

    <!-- Light Liquid Glass Theme (Day Mode) -->
    <style name="AppBaseTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:divider">@color/separatorLight</item>
        <item name="android:navigationBarColor">#D5DFEC</item>
        <item name="android:queryBackground">@drawable/rounded_rectangle_22dp</item>
        <item name="android:statusBarColor">#E6EEF8</item>
        <item name="android:textColorPrimary">#1C1C1E</item>
        <item name="android:textColorSecondary">#48484A</item>
        <item name="android:textColorTertiary">#8E8E93</item>
        <item name="android:windowBackground">@drawable/bg_glass_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="actionBarPopupTheme">@style/PopupTheme</item>
        <item name="bubbleColor">@color/bubbleLight</item>
        <item name="colorAccent">@color/apple_accent_blue</item>
        <item name="colorPrimary">#E6EEF8</item>
        <item name="colorPrimaryDark">#D5DFEC</item>
        <item name="selectableItemBackground">@drawable/ripple_light</item>
        <item name="switchThumbEnabled">#FFFFFF</item>
        <item name="switchThumbDisabled">#D1D1D6</item>
        <item name="switchTrackEnabled">#007AFF</item>
        <item name="switchTrackDisabled">#E5E5EA</item>
        <item name="windowActionBar">false</item>
    </style>

    <style name="AppThemeDialog" parent="Theme.AppCompat.Dialog">
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorTertiary">@color/text_tertiary</item>
        <item name="android:windowBackground">@drawable/bg_glass_dark</item>
        <item name="actionBarPopupTheme">@style/PopupTheme</item>
        <item name="bubbleColor">@color/bubbleDark</item>
        <item name="colorPrimary">#1B212D</item>
        <item name="colorPrimaryDark">#10141C</item>
        <item name="selectableItemBackground">@drawable/ripple_dark</item>
        <item name="windowActionBar">false</item>
    </style>

    <style name="PopupTheme" parent="ThemeOverlay.AppCompat">
        <item name="android:colorBackground">#1B212D</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <!-- Dark Liquid Glass Theme (Night Mode) - Matches user sample -->
    <style name="AppTheme.Black">
        <item name="android:navigationBarColor">#10141C</item>
        <item name="android:statusBarColor">#2B3444</item>
        <item name="android:windowBackground">@drawable/bg_glass_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#9AA4B2</item>
        <item name="android:textColorTertiary">#64748B</item>
        <item name="bubbleColor">@color/bubbleDark</item>
        <item name="colorAccent">@color/apple_accent_blue</item>
        <item name="colorPrimary">#1B212D</item>
        <item name="colorPrimaryDark">#10141C</item>
        <item name="selectableItemBackground">@drawable/ripple_dark</item>
        <item name="switchThumbEnabled">#FFFFFF</item>
        <item name="switchThumbDisabled">#636366</item>
        <item name="switchTrackEnabled">#007AFF</item>
        <item name="switchTrackDisabled">#393946</item>
    </style>

    <style name="AppThemeDialog.Black">
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#9AA4B2</item>
        <item name="android:textColorTertiary">#64748B</item>
        <item name="android:windowBackground">@drawable/bg_glass_dark</item>
        <item name="bubbleColor">@color/bubbleBlack</item>
        <item name="colorPrimary">#1B212D</item>
        <item name="colorPrimaryDark">#10141C</item>
    </style>

    <!-- Gray Theme -->
    <style name="AppTheme.Gray">
        <item name="android:navigationBarColor">#2B3444</item>
        <item name="android:statusBarColor">#374357</item>
        <item name="android:windowBackground">@drawable/bg_glass_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="bubbleColor">@color/bubbleGray</item>
        <item name="colorPrimary">#2B3444</item>
        <item name="colorPrimaryDark">#1B212D</item>
    </style>

    <style name="AppThemeDialog.Gray">
        <item name="android:windowBackground">@drawable/bg_glass_dark</item>
        <item name="bubbleColor">@color/bubbleGray</item>
        <item name="colorPrimary">#2B3444</item>
        <item name="colorPrimaryDark">#1B212D</item>
    </style>

    <style name="AppTheme.QuickReply">
        <item name="android:windowBackground">@drawable/bg_glass_dark</item>
    </style>

</resources>
