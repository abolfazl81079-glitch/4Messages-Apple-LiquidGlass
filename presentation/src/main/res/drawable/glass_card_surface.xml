<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ambient Glass Drop Shadow -->
    <item
        android:left="1dp"
        android:right="1dp"
        android:top="2dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#2A050B14" />
        </shape>
    </item>

    <!-- Translucent Liquid Glass Body with Depth Gradient -->
    <item
        android:left="0dp"
        android:right="0dp"
        android:top="0dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="270"
                android:startColor="#26FFFFFF"
                android:centerColor="#14FFFFFF"
                android:endColor="#0AFFFFFF"
                android:type="linear" />
            <!-- Crisp Luminous White Glass Rim Stroke -->
            <stroke
                android:width="2dp"
                android:color="#59FFFFFF" />
        </shape>
    </item>

    <!-- Top Specular Glare / Reflection Highlight (as in user sample image) -->
    <item
        android:left="4dp"
        android:right="4dp"
        android:top="1dp"
        android:bottom="20dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="19dp"
                android:topRightRadius="19dp"
                android:bottomLeftRadius="6dp"
                android:bottomRightRadius="6dp" />
            <gradient
                android:angle="270"
                android:startColor="#66FFFFFF"
                android:centerColor="#1AFFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
