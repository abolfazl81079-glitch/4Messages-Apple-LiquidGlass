<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Cyber Industrial Shadow -->
    <item
        android:left="0dp"
        android:right="0dp"
        android:top="2dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="#4D030609" />
        </shape>
    </item>

    <!-- Translucent Cyber Glass Surface -->
    <item
        android:left="0dp"
        android:right="0dp"
        android:top="0dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <gradient
                android:angle="270"
                android:startColor="#1E0B1622"
                android:centerColor="#14070D14"
                android:endColor="#0F030609"
                android:type="linear" />
            <!-- Thin Cyber Neon Cyan Border -->
            <stroke
                android:width="1dp"
                android:color="#3300E5FF" />
        </shape>
    </item>

    <!-- Top Specular Terminal Glare -->
    <item
        android:left="2dp"
        android:right="2dp"
        android:top="1dp"
        android:bottom="36dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="3dp"
                android:topRightRadius="3dp"
                android:bottomLeftRadius="1dp"
                android:bottomRightRadius="1dp" />
            <gradient
                android:angle="270"
                android:startColor="#2600E5FF"
                android:centerColor="#0D008CFF"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
