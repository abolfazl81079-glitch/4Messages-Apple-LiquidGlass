<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ambient Shadow -->
    <item
        android:left="1dp"
        android:right="1dp"
        android:top="1dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#20000000" />
        </shape>
    </item>

    <!-- Glass Capsule Body -->
    <item
        android:left="0dp"
        android:right="0dp"
        android:top="0dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="270"
                android:startColor="#26FFFFFF"
                android:centerColor="#14FFFFFF"
                android:endColor="#0AFFFFFF"
                android:type="linear" />
            <stroke
                android:width="2dp"
                android:color="#59FFFFFF" />
        </shape>
    </item>

    <!-- Top Specular Glare -->
    <item
        android:left="4dp"
        android:right="4dp"
        android:top="1dp"
        android:bottom="11dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="20dp"
                android:topRightRadius="20dp"
                android:bottomLeftRadius="8dp"
                android:bottomRightRadius="8dp" />
            <gradient
                android:angle="270"
                android:startColor="#66FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>