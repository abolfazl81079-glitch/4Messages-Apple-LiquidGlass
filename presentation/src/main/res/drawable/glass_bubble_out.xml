<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners
        android:topLeftRadius="20dp"
        android:topRightRadius="20dp"
        android:bottomLeftRadius="20dp"
        android:bottomRightRadius="6dp" />
    <gradient
        android:angle="45"
        android:startColor="@color/glass_bubble_out_gradient_start"
        android:endColor="@color/glass_bubble_out_gradient_end"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#4DFFFFFF" />
    <padding
        android:bottom="10dp"
        android:left="14dp"
        android:right="14dp"
        android:top="10dp" />
</shape>
