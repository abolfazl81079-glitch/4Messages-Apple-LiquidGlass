<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppLaunchTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:navigationBarColor">#10141C</item>
        <item name="android:statusBarColor">#2B3444</item>
        <item name="android:windowBackground">@drawable/bg_glass_dark</item>
    </style>

    <style name="AppTheme" parent="AppTheme.Black" />

    <style name="AppBaseTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:divider">@color/separatorDark</item>
        <item name="android:navigationBarColor">#10141C</item>
        <item name="android:queryBackground">@drawable/rounded_rectangle_22dp</item>
        <item name="android:statusBarColor">#2B3444</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#9AA4B2</item>
        <item name="android:textColorTertiary">#64748B</item>
        <item name="android:windowBackground">@drawable/bg_glass_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="actionBarPopupTheme">@style/PopupTheme</item>
        <item name="bubbleColor">@color/bubbleDark</item>
        <item name="colorAccent">@color/apple_accent_blue</item>
        <item name="colorPrimary">#1B212D</item>
        <item name="colorPrimaryDark">#10141C</item>
        <item name="selectableItemBackground">@drawable/ripple_dark</item>
        <item name="switchThumbEnabled">#FFFFFF</item>
        <item name="switchThumbDisabled">#636366</item>
        <item name="switchTrackEnabled">#007AFF</item>
        <item name="switchTrackDisabled">#393946</item>
        <item name="windowActionBar">false</item>
    </style>

</resources>
